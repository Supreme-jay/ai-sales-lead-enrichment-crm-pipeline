    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.6,\n  \"max_tokens\": 700,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a B2B sales intelligence analyst. Given a lead, do these 4 things:\\n1. Write a 2-sentence company summary based on their company name and role\\n2. Identify their most likely pain point based on their role\\n3. Score them: hot (decision maker + clear pain), warm (influencer or unclear pain), cold (no buying signal)\\n4. Write a personalized outreach email under 90 words signed from Alex at AutoFlow\\n\\nReturn ONLY valid JSON, no text outside it:\\n{\\n  \\\"company_summary\\\": \\\"2-sentence summary\\\",\\n  \\\"pain_point\\\": \\\"their top pain point\\\",\\n  \\\"lead_score\\\": \\\"hot or warm or cold\\\",\\n  \\\"score_reason\\\": \\\"1 sentence why\\\",\\n  \\\"outreach_email\\\": \\\"the email body\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Lead details:\\nName: {{ $json.body.name }}\\nEmail: {{ $json.body.email }}\\nCompany: {{ $json.body.company }}\\nRole: {{ $json.body.role }}\\nMessage: {{ $json.body.message }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -672,
        32
      ],
      "id": "04be82c3-a8d6-4663-8f07-925fa54da1df",
      "name": "HTTP Request",
      "credentials": {
        "httpHeaderAuth": {
          "id": "0DcW89UBjD4xU1q2",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\nconst rawText = aiResponse.choices[0].message.content;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch(e) {\n  const match = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('No JSON in Groq response: ' + rawText);\n  parsed = JSON.parse(match[0]);\n}\n\nconst lead = $('Webhook').first().json;\n\nreturn [{\n  json: {\n    name:            lead.name,\n    email:           lead.email,\n    company:         lead.company,\n    role:            lead.role,\n    message:         lead.message || '',\n    company_summary: parsed.company_summary || '',\n    pain_point:      parsed.pain_point      || '',\n    lead_score:      parsed.lead_score      || 'cold',\n    score_reason:    parsed.score_reason    || '',\n    outreach_email:  parsed.outreach_email  || '',\n    created_at:      new Date().toISOString()\n  }\n}];\n"
      },
